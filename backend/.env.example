# 校园内网服务器 IP，内网部署时建议改成服务器固定 IP
SERVER_IP=192.168.1.100

# 对外访问端口
FRONTEND_PORT=80
BACKEND_PORT=8080
KKFILEVIEW_PORT=8012

# 数据库
DB_USERNAME=edu
DB_PASSWORD=change-me-db-password
DB_NAME=edu
POSTGRES_PORT=5432

# JWT — 至少 256 位随机字符串 (生产环境必须修改!)
JWT_SECRET=change-me-to-a-strong-random-string-at-least-256-bits
INITIAL_ADMIN_PASSWORD=change-me-admin-password
APP_TIME_ZONE=Asia/Shanghai

# Redis
CACHE_TYPE=none
APP_CACHE_REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=edu
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# 文件预览服务地址。内网部署时改成 http://服务器IP:8012
KKFILEVIEW_BASE_URL=http://192.168.1.100:8012
KKFILEVIEW_IMAGE=keking/kkfileview:4.1.0

# 日志级别
APP_LOG_LEVEL=info
SECURITY_LOG_LEVEL=warn
