# Windows Server / 校园内网部署模板
#
# 使用方式：
# 1. 复制本文件为 backend/.env
# 2. 修改 SERVER_IP、密码和 JWT_SECRET
# 3. 在 backend 目录执行 docker compose up -d --build

# 校园内网服务器 IP，学生和教师浏览器通过这个地址访问系统。
SERVER_IP=192.168.1.100

# 对外访问端口
FRONTEND_PORT=80
BACKEND_PORT=8080
KKFILEVIEW_PORT=8012

# 数据库
DB_USERNAME=edu
DB_PASSWORD=change-this-db-password
DB_NAME=edu
POSTGRES_PORT=5432

# Redis 默认只绑定服务器本机，不暴露给校园网客户端。
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT 密钥：生产环境必须改成 32 字符以上的随机字符串。
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=edu
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# kkFileView 页面需要被浏览器访问，因此这里使用校园内网 IP。
KKFILEVIEW_BASE_URL=http://192.168.1.100:8012
KKFILEVIEW_IMAGE=keking/kkfileview:4.1.0

# 日志级别
APP_LOG_LEVEL=info
SECURITY_LOG_LEVEL=warn
